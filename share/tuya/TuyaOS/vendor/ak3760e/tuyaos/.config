CONFIG_TUYA_TARGET_CFLAGS="-Os -mcpu=cortex-a7 -mfloat-abi=hard -mfpu=neon-vfpv4 "
CONFIG_TUYA_TARGET_LDFLAGS="-mcpu=cortex-a7 -mfloat-abi=hard -mfpu=neon-vfpv4 "
# CONFIG_TUYA_ENABLE_DEBUG is not set
# end of Build Optimize Options

