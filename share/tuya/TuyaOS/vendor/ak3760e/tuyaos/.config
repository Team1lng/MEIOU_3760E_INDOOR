CONFIG_UBOOT_USER_LOAD_ADDR="0x21000000"
CONFIG_UBOOT_OTA_BACKUP_ADDR="0x22000000"
CONFIG_NVRAM_HEADER_LOAD_ADDR="0x21C00000"
CONFIG_NVRAM_VALUE_LOAD_ADDR="0x21800000"
CONFIG_NVRAM_COMMIT_ADDR="0x21400000"
CONFIG_TUYA_PACKAGE_BSP_CRYPTFS=y
CONFIG_TUYA_PACKAGE_BSP_CRYPTFS_KEY="dcc734ac6ed58f7bbdc8c9253922defc17aaeffb1ff39d7685d3debe166151d6"
CONFIG_TUYA_BSP_VERIFY_ONBOARD_NVRAM=y
CONFIG_TUYA_BSP_NVRAM_KDRIVER=y
