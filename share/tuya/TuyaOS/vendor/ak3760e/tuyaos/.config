CONFIG_TUYA_BSP_NVRAM_FLASH_SIZE="0x10000"
CONFIG_TUYA_BSP_NVRAM_FLASH_OFFSET="0x00000"
CONFIG_TUYA_BSP_NVRAM_BLKDEV_MAJOR="31"
CONFIG_TUYA_BSP_NVRAM_BLKDEV_MINOR="7"
CONFIG_TUYA_BSP_NVRAM_UBOOT_FLASH_OFFSET="0xfe0000"
