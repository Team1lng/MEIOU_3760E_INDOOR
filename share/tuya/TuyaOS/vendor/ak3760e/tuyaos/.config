# CONFIG_TUYA_TARGET_ARCH_AARCH64 is not set
# CONFIG_TUYA_TARGET_ARCH_MIPS is not set
# CONFIG_TUYA_TARGET_ARCH_MIPSEL is not set
# CONFIG_TUYA_TARGET_ARCH_RLX is not set
