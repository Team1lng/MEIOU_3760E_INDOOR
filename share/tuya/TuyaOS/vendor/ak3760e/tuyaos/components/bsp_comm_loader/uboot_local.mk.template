LOCAL_PATH := $(call my-dir)

include $(CLEAR_VARS)
LOCAL_PKG_NAME := bootloader
product :=$(call qstrip,$(CONFIG_TUYA_TARGET_BOARD_MODEL))
uboot_config := config.uboot.rts3917n_nor
uboot_version := uboot-2020.04
uboot_made_file := $(uboot_version)/include/uboot_made/uboot_made.h


ifeq ($(product),rts3917)
    product_type = RTS3917
endif


unsign_pack :=$(call qstrip,$(CONFIG_TUYA_UNSIGN_PACK))

ifeq ($(unsign_pack),y)
	unsign_config=TUYA_PACK_UNSIGN
else
	unsign_config=TUYA_PACK_SIGN
endif

# Build hw_compressed and ddr cmd_bin out of source tree
define prepare/bootloader
	@echo "nothing to prepare"
endef

define configure/bootloader
	@echo "no need to config"
	echo "configure uboot"
	cp -rf $(bootloader_src)/config/$(uboot_config) $(bootloader_src)/$(uboot_version)/.config
endef

DFLAGS := $(foreach n,$(CONFIG_TUYA_NVRAM_KERNEL_DRIVER_KEY),$(n))
$(call warning, "DFLAGS is $(DFLAGS)")

DVAR0 := $(word 1,$(DFLAGS))
DVAR1 := $(patsubst "%,%,$(DVAR0))
DDX += $(subst $(DVAR0),$(DVAR1),$(DFLAGS))
DVAR1 := $(word 1,$(DDX))

#DVAR1 := $(word 1,$(DFLAGS))
DVAR2 := $(word 2,$(DFLAGS))
DVAR3 := $(word 3,$(DFLAGS))
DVAR4 := $(word 4,$(DFLAGS))
DVAR5 := $(word 5,$(DFLAGS))
DVAR6 := $(word 6,$(DFLAGS))
DVAR7 := $(word 7,$(DFLAGS))
DVAR8 := $(word 8,$(DFLAGS))
DVAR9 := $(word 9,$(DFLAGS))
DVAR10 := $(word 10,$(DFLAGS))
DVAR11 := $(word 11,$(DFLAGS))
DVAR12 := $(word 12,$(DFLAGS))
DVAR13 := $(word 13,$(DFLAGS))
DVAR14 := $(word 14,$(DFLAGS))
DVAR15 := $(word 15,$(DFLAGS))
#DVAR16 := $(word 16,$(DFLAGS))

DVAR20 := $(word 16,$(DFLAGS))
DVAR21 := $(patsubst %",%,$(DVAR20))
DDX2 += $(subst $(DVAR20),$(DVAR21),$(DDX))
DVAR16 := $(word 16,$(DDX2))

ifneq ($(wildcard $(shell pwd)/sdk),)
    PWD := $(shell pwd)/sdk/uboot_rts3917
endif

ifneq ($(wildcard $(shell pwd)/components),)
    PWD := $(shell pwd)/components/uboot_rts3917
endif

VALUE1 = $(shell $(PWD)/make.sh "$(DVAR1)")
TYOS_LOCAL_CFLAGS += -DKEY1=$(VALUE1)

VALUE2 = $(shell $(PWD)/make.sh "$(DVAR2)")
TYOS_LOCAL_CFLAGS += -DKEY2=$(VALUE2)

VALUE3 = $(shell $(PWD)/make.sh "$(DVAR3)")
TYOS_LOCAL_CFLAGS += -DKEY3=$(VALUE3)

VALUE4 = $(shell $(PWD)/make.sh "$(DVAR4)")
TYOS_LOCAL_CFLAGS += -DKEY4=$(VALUE4)

VALUE5 = $(shell $(PWD)/make.sh "$(DVAR5)")
TYOS_LOCAL_CFLAGS += -DKEY5=$(VALUE5)

VALUE6 = $(shell $(PWD)/make.sh "$(DVAR6)")
TYOS_LOCAL_CFLAGS += -DKEY6=$(VALUE6)

VALUE7 = $(shell $(PWD)/make.sh "$(DVAR7)")
TYOS_LOCAL_CFLAGS += -DKEY7=$(VALUE7)

VALUE8 = $(shell $(PWD)/make.sh "$(DVAR8)")
TYOS_LOCAL_CFLAGS += -DKEY8=$(VALUE8)

VALUE9 = $(shell $(PWD)/make.sh "$(DVAR9)")
TYOS_LOCAL_CFLAGS += -DKEY9=$(VALUE9)

VALUE10 = $(shell $(PWD)/make.sh "$(DVAR10)")
TYOS_LOCAL_CFLAGS += -DKEY10=$(VALUE10)

VALUE11 = $(shell $(PWD)/make.sh "$(DVAR11)")
TYOS_LOCAL_CFLAGS += -DKEY11=$(VALUE11)

VALUE12 = $(shell $(PWD)/make.sh "$(DVAR12)")
TYOS_LOCAL_CFLAGS += -DKEY12=$(VALUE12)

VALUE13 = $(shell $(PWD)/make.sh "$(DVAR13)")
TYOS_LOCAL_CFLAGS += -DKEY13=$(VALUE13)

VALUE14 = $(shell $(PWD)/make.sh "$(DVAR14)")
TYOS_LOCAL_CFLAGS += -DKEY14=$(VALUE14)

VALUE15 = $(shell $(PWD)/make.sh "$(DVAR15)")
TYOS_LOCAL_CFLAGS += -DKEY15=$(VALUE15)

VALUE16 = $(shell $(PWD)/make.sh "$(DVAR16)")
TYOS_LOCAL_CFLAGS += -DKEY16=$(VALUE16)

CI_NVRAM_FLASH_SIZE=$(call qstrip,$(CONFIG_TUYA_BSP_NVRAM_FLASH_SIZE))
CI_NVRAM_FLASH_OFFSET=$(call qstrip,$(CONFIG_TUYA_BSP_NVRAM_FLASH_OFFSET))
CI_NVRAM_UBOOT_FLASH_OFFSET=$(call qstrip,$(CONFIG_TUYA_BSP_NVRAM_UBOOT_FLASH_OFFSET))
CI_NVRAM_FLASH_PARTITION_SIZE = $(call qstrip,$(CONFIG_TUYA_BSP_NVRAM_PARTITION_SIZE))

CI_CONFIG_UBOOT_USER_LOAD_ADDR=$(call qstrip,$(CONFIG_UBOOT_USER_LOAD_ADDR))
CI_CONFIG_UBOOT_OTA_BACKUP_ADDR=$(call qstrip,$(CONFIG_UBOOT_OTA_BACKUP_ADDR))
CI_CONFIG_NVRAM_HEADER_LOAD_ADDR=$(call qstrip,$(CONFIG_NVRAM_HEADER_LOAD_ADDR))
CI_CONFIG_NVRAM_VALUE_LOAD_ADDR=$(call qstrip,$(CONFIG_NVRAM_VALUE_LOAD_ADDR))
CI_CONFIG_NVRAM_COMMIT_ADDR=$(call qstrip,$(CONFIG_NVRAM_COMMIT_ADDR))

CI_CONFIG_UBOOT_MADE_HW_INIT=$(call qstrip,$(CONFIG_UBOOT_MADE_HW_INIT))
CI_CONFIG_UBOOT_MADE_OTA_BACKUP=$(call qstrip,$(CONFIG_UBOOT_MADE_OTA_BACKUP))
CI_CONFIG_UBOOT_MADE_BOOT_SD=$(call qstrip,$(CONFIG_UBOOT_MADE_BOOT_SD))
CI_CONFIG_UBOOT_MADE_OTA_SD=$(call qstrip,$(CONFIG_UBOOT_MADE_OTA_SD))
CI_CONFIG_FLASH_DOUBLE_BACK=$(call qstrip,$(CONFIG_FLASH_DOUBLE_BACK))
CI_CONFIG_UBOOT_VERSION=$(call qstrip,$(CONFIG_UBOOT_VERSION))
CI_CONFIG_UBOOT_MADE_OTA_SD_FW_NAME=$(CONFIG_UBOOT_MADE_OTA_SD_FW_NAME)



define compile/bootloader
	echo "compile uboot"
        if [ ! -f $(bootloader_src)/$(uboot_made_file) ];then  \
            cp	-rf $(bootloader_src)/../bsp_comm_loader/include/* $(bootloader_src)/$(uboot_version)/include/; \
            cp	-rf $(bootloader_src)/../bsp_comm_loader/common  $(bootloader_src)/$(uboot_version)/common/common_ty; \
	    cat $(bootloader_src)/../bsp_comm_loader/common/Makefile  >> $(bootloader_src)/$(uboot_version)/common/Makefile; \
	fi

	sed -i '/#define KEY1 /c #define KEY1 $(VALUE1)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY2 /c #define KEY2 $(VALUE2)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY3 /c #define KEY3 $(VALUE3)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY4 /c #define KEY4 $(VALUE4)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY5 /c #define KEY5 $(VALUE5)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY6 /c #define KEY6 $(VALUE6)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY7 /c #define KEY7 $(VALUE7)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY8 /c #define KEY8 $(VALUE8)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY9 /c #define KEY9 $(VALUE9)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY10 /c #define KEY10 $(VALUE10)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY11 /c #define KEY11 $(VALUE11)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY12 /c #define KEY12 $(VALUE12)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY13 /c #define KEY13 $(VALUE13)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY14 /c #define KEY14 $(VALUE14)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY15 /c #define KEY15 $(VALUE15)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define KEY16 /c #define KEY16 $(VALUE16)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define NVRAM_FLASH_SIZE/c #define NVRAM_FLASH_SIZE $(CI_NVRAM_FLASH_SIZE)' $(bootloader_src)/$(uboot_made_file)
	sed -i '/#define NVRAM_FLASH_OFFSET/c #define NVRAM_FLASH_OFFSET $(CI_NVRAM_FLASH_OFFSET)' $(bootloader_src)/$(uboot_made_file)	
	sed -i '/#define NVRAM_UBOOT_FLASH_OFFSET/c #define NVRAM_UBOOT_FLASH_OFFSET $(CI_NVRAM_UBOOT_FLASH_OFFSET)' $(bootloader_src)/$(uboot_made_file)

	sed -i '/#define NVRAM_FLASH_PARTITION_SIZE/c #define NVRAM_FLASH_PARTITION_SIZE $(CI_NVRAM_FLASH_PARTITION_SIZE)' $(bootloader_src)/$(uboot_made_file)

        if [ "$(CONFIG_TUYA_TARGET_CRYPTFS_ENABLE)$(CONFIG_TUYA_PACKAGE_BSP_CRYPTFS)" = "yy" ];then \
	     sed -i '/#define CONFIG_TUYA_CRYPTFS /c #define CONFIG_TUYA_CRYPTFS 1' $(bootloader_src)/$(uboot_made_file);  \
	     sed -i '/#define CONFIG_TUYA_CRYPTFS_KEY/c #define CONFIG_TUYA_CRYPTFS_KEY $(CONFIG_TUYA_PACKAGE_BSP_CRYPTFS_KEY)' $(bootloader_src)/$(uboot_made_file); \
	else \
	     sed -i '/#define CONFIG_TUYA_CRYPTFS /c #define CONFIG_TUYA_CRYPTFS 0' $(bootloader_src)/$(uboot_made_file); \
	fi

	if [ "$(CONFIG_FIRMWARE_STORE_MEDIUM_IS_SPI_NOR)" = "y" ];then \
            sed -i '/#define FIRMWARE_STORE_MEDIUM/c #define FIRMWARE_STORE_MEDIUM 1' $(bootloader_src)/$(uboot_made_file); \
        fi

	if [ "$(CONFIG_FIRMWARE_STORE_MEDIUM_IS_SPI_NAND)" = "y" ];then \
            sed -i '/#define FIRMWARE_STORE_MEDIUM/c #define FIRMWARE_STORE_MEDIUM 2' $(bootloader_src)/$(uboot_made_file); \
        fi

	if [ "$(CONFIG_NOR_FLASH_PROTECT_SUPPORT)" = "y" ];then \
            sed -i '/#define NOR_FLASH_PROTECT_SUPPORT/c #define NOR_FLASH_PROTECT_SUPPORT 1' $(bootloader_src)/$(uboot_made_file); \
	else   \
            sed -i '/#define NOR_FLASH_PROTECT_SUPPORT/c #define NOR_FLASH_PROTECT_SUPPORT 0' $(bootloader_src)/$(uboot_made_file); \
        fi


        sed -i '/#define CONFIG_TUYA_PACK/c #define CONFIG_$(unsign_config) 1' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define CONFIG_TUYA_CONFIG/c#define CONFIG_TUYA_PRODUCT_$(product_type)' $(bootloader_src)/$(uboot_made_file)

        sed -i '/#define UBOOT_USER_LOAD_ADDR/c #define UBOOT_USER_LOAD_ADDR $(CI_CONFIG_UBOOT_USER_LOAD_ADDR)' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define UBOOT_OTA_BACKUP_ADDR/c #define UBOOT_OTA_BACKUP_ADDR $(CI_CONFIG_UBOOT_OTA_BACKUP_ADDR)' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define NVRAM_HEADER_LOAD_ADDR/c #define NVRAM_HEADER_LOAD_ADDR $(CI_CONFIG_NVRAM_HEADER_LOAD_ADDR)' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define NVRAM_VALUE_LOAD_ADDR/c #define NVRAM_VALUE_LOAD_ADDR $(CI_CONFIG_NVRAM_VALUE_LOAD_ADDR)' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define NVRAM_COMMIT_ADDR/c #define NVRAM_COMMIT_ADDR $(CI_CONFIG_NVRAM_COMMIT_ADDR)' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define UBOOT_MADE_HW_INIT/c #define UBOOT_MADE_HW_INIT $(CI_CONFIG_UBOOT_MADE_HW_INIT)' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define UBOOT_MADE_OTA_BACKUP/c #define UBOOT_MADE_OTA_BACKUP $(CI_CONFIG_UBOOT_MADE_OTA_BACKUP)' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define UBOOT_MADE_BOOT_SD/c #define UBOOT_MADE_BOOT_SD $(CI_CONFIG_UBOOT_MADE_BOOT_SD)' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define UBOOT_MADE_OTA_SD/c #define UBOOT_MADE_OTA_SD $(CI_CONFIG_UBOOT_MADE_OTA_SD)' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define FLASH_DOUBLE_BACK/c #define FLASH_DOUBLE_BACK $(CI_CONFIG_FLASH_DOUBLE_BACK)' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define UBOOT_VERSION/c #define UBOOT_VERSION $(CI_CONFIG_UBOOT_VERSION)' $(bootloader_src)/$(uboot_made_file)
        sed -i '/#define UBOOT_MADE_SD_OTA_FW_NAME/c #define UBOOT_MADE_SD_OTA_FW_NAME $(CI_CONFIG_UBOOT_MADE_OTA_SD_FW_NAME)' $(bootloader_src)/$(uboot_made_file)

	echo "make -C $(bootloader_src)/$(uboot_version) CROSS_COMPILE=$(CROSS_COMPILE) clean"
	make -C $(bootloader_src)/$(uboot_version) CROSS_COMPILE=$(CROSS_COMPILE) clean
	echo "make -C $(bootloader_src)/$(uboot_version) CROSS_COMPILE=$(CROSS_COMPILE)"
	make -C $(bootloader_src)/$(uboot_version) CROSS_COMPILE=$(CROSS_COMPILE)
	echo "make done"
endef

define install/bootloader
	cp -rf $(bootloader_src)/$(uboot_version)/u-boot.bin $(TARGET_IMAGES)/u-boot.bin 
endef

uboot-menuconfig:
	make -C $(bootloader_src)/$(uboot_version) CROSS_COMPILE=$(CROSS_COMPILE) menuconfig

ubood-savedefconfig:
#	make -C $(kernel_src)/$(KERNEL_VERSION) ARCH=$(TARGET_ARCH) CROSS_COMPILE=$(CROSS_COMPILE) savedefconfig
	cp -v $(bootloader_src)/$(uboot_version)/.config $(TARGET_BOOTLOADER_CONFIG)

include $(BUILD_PACKAGE)
