menuconfig TUYA_PACKAGE_LIBCONFIG
	bool "libconfig"
	help
	  Libconfig is a simple library for manipulating structured
	  configuration files. The file format is more compact and more
	  readable than XML. And unlike XML, it is type-aware, so it is
	  not necessary to do string parsing in application code.

	  https://hyperrealm.github.io/libconfig/

if TUYA_PACKAGE_LIBCONFIG

config TUYA_PACKAGE_LIBCONFIG_VERSION
	string "libconfig version to use?"
	default "libconfig-1.7.2"
	help
	  Select which version to use.

config TUYA_PACKAGE_LIBCONFIG_CPP_SUPPORT
	bool "enable libconfig++ support"
	default n

endif
