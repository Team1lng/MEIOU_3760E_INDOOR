menuconfig TUYA_PACKAGE_BLUEZ5_UTILS
	bool "bluez-utils 5.x"
	select TUYA_PACKAGE_DBUS
	select TUYA_PACKAGE_LIBGLIB2
	help
	  bluez utils version 5.x

	  With this release BlueZ only supports the new Bluetooth
	  Management kernel interface (introduced in Linux 3.4).

	  For Low Energy support at least kernel version 3.5 is
	  needed.

	  The API is not backward compatible with BlueZ 4.

	  Bluez utils will use systemd and/or udev if enabled.

	  http://www.bluez.org
	  http://www.kernel.org/pub/linux/bluetooth

if TUYA_PACKAGE_BLUEZ5_UTILS

config TUYA_PACKAGE_BLUEZ5_UTILS_VERSION
	string "bluez5 version to use?"
	default "bluez-5.50"
	help
	  Select which version to use.

#config TUYA_PACKAGE_BLUEZ5_UTILS_OBEX
#	bool "build OBEX support"
#	select TUYA_PACKAGE_LIBICAL
#	help
#	  Enable the OBEX support in Bluez 5.x.

config TUYA_PACKAGE_BLUEZ5_UTILS_CLIENT
	bool "build CLI client"
	select TUYA_PACKAGE_READLINE
	help
	  Enable the Bluez 5.x command line client.

config TUYA_PACKAGE_BLUEZ5_UTILS_DEPRECATED
	bool "install deprecated tool"
	depends on TUYA_PACKAGE_BLUEZ5_UTILS_CLIENT
	help
	  Build BlueZ 5.x deprecated tools. These currently include:
	  hciattach, hciconfig, hcitool, hcidump, rfcomm, sdptool,
	  ciptool, gatttool.

config TUYA_PACKAGE_BLUEZ5_UTILS_GATTTOOL
	bool "install GATT tool"
	depends on TUYA_PACKAGE_BLUEZ5_UTILS_CLIENT
	help
	  Generic Attribute Profile (GATT) support. This provides
	  profile discovery and description services for Bluetooth Low
	  Energy. This will install the gatttool utility.

	  It is always built with BlueZ 5.x, but upstream choose not
	  to install it by default.

config TUYA_PACKAGE_BLUEZ5_UTILS_EXPERIMENTAL
	bool "build experimental plugins"
	help
	  Build BlueZ 5.x experimental plugins (SAP, NFC, ...).

config TUYA_PACKAGE_BLUEZ5_UTILS_TEST
	bool "build tests"
	help
	  Build BlueZ 5.x tests

endif
