menuconfig TUYA_PACKAGE_BUSYBOX
	bool "BusyBox"
	default y
	help
	  The Swiss Army Knife of embedded Linux. It slices, it dices,
	  it makes Julian Fries.

	  http://busybox.net/

	  Most people will answer Y.

if TUYA_PACKAGE_BUSYBOX

config TUYA_PACKAGE_BUSYBOX_VERSION
	string "BusyBox version to use?"
	default "busybox-1.31.1"
	help
	  Select which busybox version to use.

config TUYA_PACKAGE_BUSYBOX_CONFIG
	string "BusyBox configuration file to use?"
	default "base_bsp/package/busybox/busybox.config"
	help
	  Some people may wish to use their own modified BusyBox
	  configuration file, and will specify their config file
	  location with this option.

	  Most people will just use the default BusyBox configuration
	  file.

endif
