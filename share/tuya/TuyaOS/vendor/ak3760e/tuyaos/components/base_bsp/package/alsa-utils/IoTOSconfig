	bool "arecordmidi"
	select TUYA_PACKAGE_ALSA_LIB_SEQ

config TUYA_PACKAGE_ALSA_UTILS_ASEQDUMP
	bool "aseqdump"
	select TUYA_PACKAGE_ALSA_LIB_SEQ

config TUYA_PACKAGE_ALSA_UTILS_ASEQNET
	bool "aseqnet"
	select TUYA_PACKAGE_ALSA_LIB_SEQ

config TUYA_PACKAGE_ALSA_UTILS_BAT
	bool "bat"
	select TUYA_PACKAGE_FFTW
