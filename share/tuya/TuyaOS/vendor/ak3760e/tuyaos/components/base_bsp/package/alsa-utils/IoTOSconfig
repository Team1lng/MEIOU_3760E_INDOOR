	help
	  Select which version to use.

config TUYA_PACKAGE_ALSA_UTILS_ALSACONF
	bool "alsaconf"

config TUYA_PACKAGE_ALSA_UTILS_ACONNECT
	bool "aconnect"
	select TUYA_PACKAGE_ALSA_LIB_SEQ

config TUYA_PACKAGE_ALSA_UTILS_ALSACTL
	bool "alsactl"
	default y

config TUYA_PACKAGE_ALSA_UTILS_ALSALOOP
	bool "alsaloop"

config TUYA_PACKAGE_ALSA_UTILS_ALSAMIXER
	bool "alsamixer"
	default y
	select TUYA_PACKAGE_NCURSES
	select TUYA_PACKAGE_ALSA_LIB_MIXER

config TUYA_PACKAGE_ALSA_UTILS_ALSAUCM
	bool "alsaucm"
	select TUYA_PACKAGE_ALSA_LIB_UCM

config TUYA_PACKAGE_ALSA_UTILS_ALSATPLG
	bool "alsatplg"

config TUYA_PACKAGE_ALSA_UTILS_AMIDI
	bool "amidi"
	select TUYA_PACKAGE_ALSA_LIB_RAWMIDI

