menuconfig TUYA_PACKAGE_UTIL_LINUX
	bool "util-linux"
	help
	  Various useful/essential linux libraries and utilities.

	  Things like mkfs, mkswap, swapon, fdisk, mount, dmesg, etc...

	  http://www.kernel.org/pub/linux/utils/util-linux/

if TUYA_PACKAGE_UTIL_LINUX

config TUYA_PACKAGE_UTIL_LINUX_VERSION
	string "util-linux version to use?"
	default "util-linux-2.35.1"
	help
	  Select which version to use.

config TUYA_PACKAGE_UTIL_LINUX_LIBBLKID
	bool "libblkid"
	help
	  Install libblkid.

config TUYA_PACKAGE_UTIL_LINUX_LIBFDISK
	bool "libfdisk"
	select TUYA_PACKAGE_UTIL_LINUX_LIBBLKID
	select TUYA_PACKAGE_UTIL_LINUX_LIBUUID
	help
	  Install libfdisk.

config TUYA_PACKAGE_UTIL_LINUX_LIBMOUNT
	bool "libmount"
	select TUYA_PACKAGE_UTIL_LINUX_LIBBLKID
	help
	  Install libmount.

config TUYA_PACKAGE_UTIL_LINUX_LIBSMARTCOLS
	bool "libsmartcols"
	help
	  Install libsmartcols.

config TUYA_PACKAGE_UTIL_LINUX_LIBUUID
	bool "libuuid"
	help
	  Install libuuid.

config TUYA_PACKAGE_UTIL_LINUX_BINARIES
	bool "basic set"
	select TUYA_PACKAGE_UTIL_LINUX_LIBBLKID
	select TUYA_PACKAGE_UTIL_LINUX_LIBMOUNT
	select TUYA_PACKAGE_UTIL_LINUX_LIBFDISK
	select TUYA_PACKAGE_UTIL_LINUX_LIBSMARTCOLS
	select TUYA_PACKAGE_UTIL_LINUX_LIBUUID
	help
	  Install the basic set of util-linux binaries.

	  blkdiscard, blkid, blockdev, chcpu, choom, col, colcrt, colrm,
	  column, ctrlaltdel, dmesg, fdisk, fincore, findfs, findmnt,
	  flock, fsfreeze, fstrim, getopt, hexdump, ipcmk, isosize,
	  ldattach, look, lsblk, lscpu, lsipc, lslocks, lsns, mcookie,
	  mkfs, mkswap, namei, prlimit, readprofile, renice, rev,
	  rtcwake, script, scriptlive, scriptreplay, setarch, setsid,
	  sfdisk, swaplabel, swapoff, swapon, uuidgen, uuidparse,
	  whereis, wipefs

	  The setarch utility also installs architecture-specific
	  symlinks like linux32, linux64, uname26, i386 and x86_64.

