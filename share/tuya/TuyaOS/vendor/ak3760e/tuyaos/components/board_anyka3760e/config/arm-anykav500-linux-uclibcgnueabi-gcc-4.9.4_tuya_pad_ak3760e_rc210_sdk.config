CONFIG_TUYA_DEFCONFIG="/new_home/jsliu/ci-project/test/tuya_pad_ak3760e_sdk/build/config/arm-anykav500-linux-uclibcgnueabi-gcc-4.9.4_tuya_pad_ak3760e_rc210_sdk.config"

#
# Tuya Linux BSP base packages
#

#
# Tuya BSP system configuration
#

#
# Platform selection
#
CONFIG_TUYA_TARGET_ARCH_ARM=y
# CONFIG_TUYA_TARGET_ARCH_AARCH64 is not set
# CONFIG_TUYA_TARGET_ARCH_MIPS is not set
# CONFIG_TUYA_TARGET_ARCH_MIPSEL is not set
CONFIG_TUYA_TARGET_ARCH="arm"
CONFIG_TUYA_TARGET_ENDIAN="little"
CONFIG_TUYA_CROSS_COMPILE=""
# end of Platform selection

#
# Filesystem selection
#
CONFIG_TUYA_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TUYA_TARGET_ROOTFS_JFFS2 is not set
# CONFIG_TUYA_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_TUYA_TARGET_ROOTFS_UBIFS is not set
# CONFIG_TUYA_TARGET_ROOTFS_EXT4 is not set
# end of Filesystem selection

#
# Build Optimize Options
#
CONFIG_TUYA_TARGET_CFLAGS="-Os"
CONFIG_TUYA_TARGET_LDFLAGS=""
# CONFIG_TUYA_ENABLE_DEBUG is not set
# end of Build Optimize Options

#
# System security options
#
CONFIG_TUYA_TARGET_ROOT_PASSWD="Tuya.140616"
CONFIG_TUYA_TARGET_PASSWD_METHOD="md5"
# CONFIG_TUYA_TARGET_SECURE_BOOT is not set
# CONFIG_TUYA_TARGET_CRYPTFS_ENABLE is not set
# end of System security options

CONFIG_TUYA_TARGET_HOSTNAME="Tuya Linux"
CONFIG_TUYA_ROOTFS_OVERLAY="sdk/board_anyka3760e/prebuild/rootfs_ori"
CONFIG_TUYA_TARGET_GENERIC_GETTY=y

#
# getty options
#
CONFIG_TUYA_TARGET_GENERIC_GETTY_PORT="ttySAK0"
# CONFIG_TUYA_TARGET_GENERIC_GETTY_BAUDRATE_KEEP is not set
# CONFIG_TUYA_TARGET_GENERIC_GETTY_BAUDRATE_9600 is not set
# CONFIG_TUYA_TARGET_GENERIC_GETTY_BAUDRATE_19200 is not set
# CONFIG_TUYA_TARGET_GENERIC_GETTY_BAUDRATE_38400 is not set
# CONFIG_TUYA_TARGET_GENERIC_GETTY_BAUDRATE_57600 is not set
CONFIG_TUYA_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
# CONFIG_TUYA_TARGET_GENERIC_GETTY_BAUDRATE_1500000 is not set
CONFIG_TUYA_TARGET_GENERIC_GETTY_BAUDRATE="115200"
CONFIG_TUYA_TARGET_GENERIC_GETTY_TERM="vt100"
CONFIG_TUYA_TARGET_GENERIC_GETTY_OPTIONS=""
# end of getty options

# CONFIG_TUYA_DEVICE_CREATION_STATIC is not set
CONFIG_TUYA_DEVICE_CREATION_DYNAMIC=y
# end of Tuya BSP system configuration

CONFIG_TUYA_PACKAGE_BUSYBOX=y
CONFIG_TUYA_PACKAGE_BUSYBOX_VERSION="busybox-1.31.1"
CONFIG_TUYA_PACKAGE_BUSYBOX_CONFIG="board_anyka3760e/config/busybox.config"

